# === Codism AI Panel - Environment ===
PORT=3000
JWT_SECRET=change_this_to_a_very_long_random_string_min_32_chars

# Upstream CodeCraft
UPSTREAM_BASE_URL=https://codecraftapi.com/v1
# IMPORTANT: never put your real key here. Set it in the host's env/secrets only.
UPSTREAM_API_KEY=cc_YOUR_REAL_KEY_HERE

# Public base URL (your domain)
PUBLIC_BASE_URL=https://panel.tvframe.vip
# اگر ساب‌دامین ساختی مثلا https://ai.tvframe.vip اینجا بذار
# PUBLIC_BASE_URL=https://ai.tvframe.vip

ADMIN_EMAIL=admin@tvframe.vip
ADMIN_PASSWORD=<set-a-strong-password-at-deploy-time>
